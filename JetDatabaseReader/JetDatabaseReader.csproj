<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <PackageId>DWJetDatabaseReader</PackageId>
    <Version>3.0.0-dw.1</Version>
    <AssemblyName>JetDatabaseReader</AssemblyName>
    <Authors>Diego Ripera;Noah Fetz</Authors>
    <Description>Temporary Planura fork of JetDatabaseReader 3.0.0 with opt-in support for verified legacy deleted-column row layouts.</Description>
    <PackageTags>access;jet;mdb;accdb;database;microsoft-access</PackageTags>
    <PackageProjectUrl>https://github.com/NoahFetz/JetDatabaseReader</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NoahFetz/JetDatabaseReader</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Temporary fork of JetDatabaseReader 3.0.0. Adds the opt-in AllowDeletedColumnGaps reader option; default behavior remains unchanged.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!--
    Rewrite source paths to a repository-relative form in Release output.

    Without this the shipped assembly and its symbols carry the absolute paths of whatever machine
    built them: the .dll records where its .pdb sat, and the .pdb records every source file by full
    path. Neither is visible in the source, and both go out with the package. SourceLink is already
    active, so debuggers resolve the sources from GitHub rather than from those paths — they were
    only ever telling people about the build machine.

    Release only: a local Debug build keeps real paths so stepping into the library still works.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <!-- Lets the tests cover internal parsing helpers directly, so logic that has no public
       entry point (connection strings, the Jet password field) is still verifiable. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>JetDatabaseReader.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
